# Supabase — encontre em Project Settings > API no painel do Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-aqui
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-aqui

# Resend (envio de e-mails) — https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# E-mail que representa o remetente das notificações (precisa de domínio verificado no Resend)
RESEND_FROM_EMAIL=Fin-Hub <notificacoes@seudominio.com.br>
# E-mail do responsável financeiro que recebe notificação de toda nova solicitação
FINANCIAL_NOTIFICATION_EMAIL=financeiro@avante.com.br

# URL pública da aplicação (usada nos links dos e-mails). Em produção, a URL do Vercel.
NEXT_PUBLIC_APP_URL=http://localhost:3000
